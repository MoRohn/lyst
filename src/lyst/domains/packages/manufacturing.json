    "scrap",
    "scrap_units",
    "defects",
    "rejected_units"
   ],
   "format": "number",
   "higher_is_better": false,
   "description": ""
  },
  {
   "name": "downtime_minutes",
   "title": "Downtime (minutes)",
   "agg": "sum",
   "columns": [
    "downtime",
    "downtime_minutes"
   ],
   "format": "number",
   "higher_is_better": false,
   "description": ""
  },
  {
   "name": "cycle_time",
   "title": "Cycle time",
   "agg": "avg",
   "columns": [
    "cycle_time",
    "cycle_time_seconds"
