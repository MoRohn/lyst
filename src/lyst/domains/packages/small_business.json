  },
  {
   "name": "Payments",
   "signals": [
    "payment",
    "payout",
    "deposit"
   ]
  }
 ],
 "glossary": [
  {
   "term": "invoiced",
   "definition": "Income billed to clients, counted on the date each invoice was issued, whether or not it has been paid yet.",
   "metric": "invoiced"
  },
  {
   "term": "outstanding",
   "definition": "Invoices sent but not yet paid (accounts receivable)."
  },
  {
   "term": "client concentration",
   "definition": "The share of income that comes from the largest client; a high share means the business depends on one relationship."
  }
 ],
 "notes": "Many small businesses keep one export per tool (an invoicing app, a bank or card). Amount columns are told apart by the export they sit in."
}
