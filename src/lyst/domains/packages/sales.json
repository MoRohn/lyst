  {
   "name": "bookings",
   "title": "Bookings",
   "agg": "sum",
   "columns": [
    "bookings",
    "booking_amount",
    "amount_won",
    "acv"
   ],
   "format": "currency",
   "higher_is_better": true,
   "description": ""
  },
  {
   "name": "pipeline_value",
   "title": "Pipeline value",
   "agg": "sum",
   "columns": [
    "pipeline",
    "pipeline_amount",
    "opportunity_amount",
    "deal_amount"
   ],
   "format": "currency",
   "higher_is_better": true,
   "description": ""
  },
  {
   "name": "orders",
   "title": "Orders",
   "agg": "count_distinct",
   "columns": [
    "order_id",
    "order_number"
   ],
   "format": "number",
   "higher_is_better": true,
   "description": ""
  },
  {
   "name": "arr",
   "title": "Annual recurring revenue",
   "agg": "sum",
   "columns": [
    "arr",
    "annual_recurring_revenue"
   ],
   "format": "currency",
   "higher_is_better": true,
   "description": ""
  },
  {
   "name": "quota",
   "title": "Quota",
   "agg": "sum",
   "columns": [
    "quota",
    "quota_amount",
    "target"
   ],
   "format": "currency",
   "higher_is_better": true,
   "description": ""
  }
 ],
 "questions": [
