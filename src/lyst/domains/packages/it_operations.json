 "metrics": [
  {
   "name": "incidents",
   "title": "Incidents",
   "agg": "count_distinct",
   "columns": [
    "incident_id"
   ],
   "format": "number",
   "higher_is_better": true,
   "description": ""
  },
  {
   "name": "downtime_minutes",
   "title": "Downtime (minutes)",
   "agg": "sum",
   "columns": [
    "downtime_minutes",
    "outage_minutes"
   ],
   "format": "number",
   "higher_is_better": false,
   "description": ""
  },
  {
   "name": "cloud_cost",
   "title": "Cloud cost",
   "agg": "sum",
   "columns": [
    "cloud_cost",
    "cost",
    "unblended_cost"
   ],
   "format": "currency",
   "higher_is_better": false,
   "description": ""
  },
  {
   "name": "latency_ms",
   "title": "Latency (ms)",
   "agg": "avg",
   "columns": [
    "latency_ms",
    "response_time_ms",
    "p95_latency"
   ],
   "format": "number",
   "higher_is_better": false,
   "description": ""
  }
 ],
 "questions": [
  "Which services had the most severe incidents this quarter?",
