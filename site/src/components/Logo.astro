---
/** The Lyst lockup (mark + wordmark) or mark alone, generated by scripts/build-brand.mjs. */
import brand from '../data/brand.json';

interface Props {
  variant?: 'lockup' | 'mark';
  tone?: 'ink' | 'light';
  height?: number;
  id: string;
  class?: string;
  label?: string;
}

const { variant = 'lockup', tone = 'ink', height = 28, id, class: className, label = 'Lyst' } = Astro.props;
const { mark, colors, lockup } = brand;
const width = variant === 'mark' ? height : Math.round((lockup.width / lockup.height) * height);
const viewBox = variant === 'mark' ? mark.viewBox : `0 0 ${lockup.width} ${lockup.height}`;
const textFill = tone === 'light' ? colors.offwhite : colors.graphite;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={width}
  height={height}
  role="img"
  aria-label={label}
  class={className}
>
  <defs>
    <linearGradient id={`${id}-s`} x1="9" y1="1" x2="9" y2="31" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={colors.stemTop}></stop>
      <stop offset="1" stop-color={colors.stemBottom}></stop>
    </linearGradient>
    <linearGradient id={`${id}-f`} x1="3" y1="27" x2="29" y2="25" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={colors.footStart}></stop>
      <stop offset="1" stop-color={colors.footEnd}></stop>
    </linearGradient>
  </defs>
  <path d={mark.foot} fill={`url(#${id}-f)`}></path>
  <path d={mark.stem} fill={`url(#${id}-s)`}></path>
  {variant === 'lockup' && <path transform={lockup.transform} d={lockup.wordmark} fill={textFill}></path>}
</svg>
