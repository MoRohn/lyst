---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import overview from '../assets/product/studio-overview.png';
import answerLight from '../assets/product/analyst-answer-light.png';
import answerDark from '../assets/product/analyst-answer-dark.png';
import homeLight from '../assets/product/home-light.png';
import homeDark from '../assets/product/home-dark.png';
import whatifLight from '../assets/product/explorer-light.png';
import whatifDark from '../assets/product/explorer-dark.png';
import dataLight from '../assets/product/data-map-light.png';
import dataDark from '../assets/product/data-map-dark.png';
import graphLight from '../assets/product/brain-graph-light.png';
import graphDark from '../assets/product/brain-graph-dark.png';
import trustLight from '../assets/product/data-trust-light.png';
import trustDark from '../assets/product/data-trust-dark.png';
import healthLight from '../assets/product/health-light.png';
import healthDark from '../assets/product/health-dark.png';
import needsLight from '../assets/product/needsyou-light.png';
import needsDark from '../assets/product/needsyou-dark.png';
import paletteLight from '../assets/product/palette-light.png';
import paletteDark from '../assets/product/palette-dark.png';
import convoLight from '../assets/product/conversation-light.png';
import convoDark from '../assets/product/conversation-dark.png';
import specsLight from '../assets/product/specialists-light.png';
import specsDark from '../assets/product/specialists-dark.png';

type Callout = { icon: string; text: string; x: string; y: string };
type View = { id: string; tab: string; img: ImageMetadata; dark?: ImageMetadata; alt: string; callouts: Callout[] };

const views: View[] = [
  {
    id: 'home', tab: 'Home', img: homeLight, dark: homeDark,
    alt: 'Lyst Home: the Lyst agent bar at the top (ask anything, speak, or go to a page; 2 need you), suggested questions, and an activity board with Suggested, Needs you, In progress and Done columns, holding next steps such as “Look inside EMEA by product line” and a finished analysis.',
    callouts: [
      { icon: 'Mic', text: 'One bar to ask, speak or go anywhere', x: '55%', y: '11.5%' },
      { icon: 'KanbanSquare', text: 'An activity board on every page', x: '40%', y: '40.3%' },
      { icon: 'MousePointerClick', text: 'Next steps, one click away', x: '42%', y: '56%' },
    ],
  },
  {
    id: 'answer', tab: 'Answer', img: answerLight, dark: answerDark,
    alt: 'Lyst answering “Why did operating margin change last quarter?” as a canvas under the agent bar, which shows the task’s live progress: a verified headline (32.5% in Q3 2026, down 3.5 points), evidence naming EMEA as the driver, a monthly trend, what it means and what to do, with Summary, Detail and Method views, a Brief, Focus and More, and an evidence rail listing the checks passed, the data and version used, assumptions and method.',
    callouts: [
      { icon: 'BadgeCheck', text: 'Every figure recomputed', x: '42%', y: '35.8%' },
      { icon: 'PanelRight', text: 'Evidence rail: checks, data, assumptions', x: '70%', y: '69%' },
      { icon: 'ListChecks', text: 'What it means, what to do', x: '63%', y: '91.5%' },
    ],
  },
  {
    id: 'convo', tab: 'Conversation', img: convoLight, dark: convoDark,
    alt: 'Lyst replying in conversation to “What can you help me with here?”: a plain answer about what it can do with this workspace’s approved metrics and datasets, labelled “A reply from what’s in this workspace. Nothing was computed, so there was nothing to verify.”, followed by offers under “Want me to”.',
    callouts: [
      { icon: 'MessageSquareText', text: 'Plain replies, honestly labelled', x: '70%', y: '46%' },
      { icon: 'CornerDownRight', text: 'Say yes, or pick an offer', x: '45%', y: '56%' },
    ],
  },
  {
    id: 'whatif', tab: 'What if', img: whatifLight, dark: whatifDark,
    alt: 'The What if explorer in Lyst: sliders for revenue (+3%), COGS ratio, operating expenses (+6%) and labor share; operating margin 36.0% to 35.4% marked Worse and operating income $9.04M to $9.15M marked Better; what moves it most, worst, base and best cases, and a Monte Carlo range. All results labelled hypothetical.',
    callouts: [
      { icon: 'SlidersHorizontal', text: 'Move a driver, see the result', x: '62%', y: '10.4%' },
      { icon: 'ArrowUpDown', text: 'Better or worse, at a glance', x: '55%', y: '45.7%' },
      { icon: 'Dices', text: 'Worst, base, best and Monte Carlo', x: '58%', y: '85%' },
    ],
  },
  {
    id: 'data', tab: 'Data', img: dataLight, dark: dataDark,
    alt: 'Lyst Data: an answer-first header noting what needs attention, the activity strip, a library of datasets and approved metrics, and a map of how the five datasets connect through the columns they share, such as month, region and product line.',
    callouts: [
      { icon: 'Network', text: 'How datasets connect, through shared columns', x: '50%', y: '81.5%' },
    ],
  },
  {
    id: 'trust', tab: 'Data trust', img: trustLight, dark: trustDark,
    alt: 'A dataset in Lyst, “P&L from the ledger”, with its sensitivity level, source of truth, and “Before you rely on it · 3”: a repeated row at its grain that would double count sums (Fix first), a negative cost value and a missing revenue value (Worth a look).',
    callouts: [
      { icon: 'TriangleAlert', text: 'Quality risks found on its own', x: '45%', y: '70%' },
    ],
  },
  {
    id: 'health', tab: 'Out of date', img: healthLight, dark: healthDark,
    alt: 'A saved analysis in Lyst marked Out of date: “Pnl is now v2; this was built on v1”, with a proposal to re-run its question and a Rebuild it button.',
    callouts: [
      { icon: 'RefreshCcw', text: 'Knows when its data changed', x: '58%', y: '62.5%' },
      { icon: 'Wrench', text: 'One click to rebuild, re-verified', x: '17%', y: '67.8%' },
    ],
  },
  {
    id: 'team', tab: 'Brain · Work', img: needsLight, dark: needsDark,
    alt: 'Lyst Brain: what Lyst knows (6 approved metrics, 5 datasets, memories and terms), what it is doing (2 need you, 4 finished this week) and what it runs on its own, then Work › Needs you: an answer Sam Ortiz assigned with a due date, and a review waiting with Approve and Reject.',
    callouts: [
      { icon: 'Brain', text: 'What it knows, what it is doing, what runs on its own', x: '30%', y: '46%' },
      { icon: 'CalendarClock', text: 'Assigned, with a due date', x: '52%', y: '74.5%' },
    ],
  },
  {
    id: 'graph', tab: 'Graph', img: graphLight, dark: graphDark,
    alt: 'Lyst Brain › Graph: an interactive map joining approved metrics, datasets, analyses, a memory and a business term, linked only where Lyst recorded a relation or a literal mention, with search, zoom and a List view.',
    callouts: [
      { icon: 'Share2', text: 'Everything Lyst knows, and how it links', x: '30%', y: '80%' },
      { icon: 'ShieldCheck', text: 'Only recorded relations, never guesses', x: '28%', y: '33%' },
    ],
  },
  {
    id: 'specs', tab: 'Specialists', img: specsLight, dark: specsDark,
    alt: 'Lyst Brain › Specializations: 136 kinds of analyst work across 11 areas, 30 defined, 98 equipped and 8 operational, with a search box, an area filter, “What Lyst can’t do yet · 10”, and specializations such as Data Analyst and Business Intelligence Analyst (Operational), each with its maturity.',
    callouts: [
      { icon: 'BadgeCheck', text: 'Honest maturity, and what is missing', x: '40%', y: '23.5%' },
      { icon: 'GraduationCap', text: '136 kinds of analyst work', x: '50%', y: '29.5%' },
    ],
  },
  {
    id: 'palette', tab: '⌘K', img: paletteLight, dark: paletteDark,
    alt: 'The Lyst command palette (⌘K) searching “revenue forecast”: ask Lyst directly, matching metrics and saved analyses, and matching specialist expertise such as Forecasting Analyst and FP&A Analyst with their maturity levels.',
    callouts: [
      { icon: 'Command', text: 'Ask, jump or find from anywhere', x: '60%', y: '9%' },
      { icon: 'GraduationCap', text: 'Expertise, with honest maturity', x: '58%', y: '79%' },
    ],
  },
  {
    id: 'overview', tab: 'Dashboard', img: overview,
    alt: 'A dashboard generated by Lyst Studio: operating margin 32.4% and revenue $8.23M with sparklines, a monthly margin trend with a forecast band and anomaly markers, computed findings, and margin and revenue by region.',
    callouts: [
      { icon: 'TrendingUp', text: 'Forecast with an 80% interval', x: '50%', y: '45.5%' },
      { icon: 'Sparkles', text: 'Findings computed from the numbers', x: '71%', y: '26.4%' },
      { icon: 'MousePointerClick', text: 'Click a bar to filter the page', x: '30%', y: '62.2%' },
    ],
  },
];
import { studio } from '../data/content';
---

<section class="section studio" id="studio" aria-labelledby="studio-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">{studio.eyebrow}</p>
      <h2 id="studio-title" class="h2">{studio.headline}</h2>
      <p class="lede">{studio.lede}</p>
    </div>

    <div class="frame" data-reveal data-studio>
      <div class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="Product views">
          {
            views.map((v, i) => (
              <button
                type="button"
                role="tab"
                id={`st-tab-${v.id}`}
                aria-controls={`st-view-${v.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {v.tab}
              </button>
            ))
          }
        </div>
        <span class="badge">Real output · sample data</span>
        <button type="button" class="theme" data-theme-toggle aria-pressed="false">
          <Icon name="Moon" size={15} class="i-moon" />
          <Icon name="Sun" size={15} class="i-sun" />
          <span class="sr-only">Show the dark theme</span>
        </button>
      </div>
      {
        views.map((v, i) => (
          <figure class="view" id={`st-view-${v.id}`} role="tabpanel" aria-labelledby={`st-tab-${v.id}`} hidden={i !== 0}>
            {v.dark && (
              <Picture
                src={v.dark}
                formats={['avif', 'webp']}
                widths={[720, 1200, 1800, 2400]}
                sizes="(max-width: 1240px) 100vw, 1200px"
                alt={`${v.alt} Dark theme.`}
                loading="lazy"
                decoding="async"
                class="img dark-img"
                style={`aspect-ratio:${v.dark.width} / ${v.dark.height}`}
              />
            )}
            <Picture
              src={v.img}
              formats={['avif', 'webp']}
              widths={[720, 1200, 1800, 2400]}
              sizes="(max-width: 1240px) 100vw, 1200px"
              alt={v.alt}
              loading="lazy"
              decoding="async"
              class={v.dark ? 'img light-img' : 'img'}
              style={`aspect-ratio:${v.img.width} / ${v.img.height}`}
            />
            {v.callouts.map((c) => (
              <span class="callout" style={`left:${c.x};top:${c.y}`} aria-hidden="true">
                <Icon name={c.icon} size={14} /> {c.text}
              </span>
            ))}
          </figure>
        ))
      }
    </div>

    <h3 class="steps-label">{studio.stepsLabel}</h3>
    <ol class="steps">
      {
        studio.steps.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <span class="ic"><Icon name={s.icon} size={18} /></span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .frame {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    background: #fbfcfb;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .tabs {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--white);
  }

  .tabs button {
    flex: none;
    white-space: nowrap;
    min-height: 32px;
    padding: 0.2rem 0.8rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 550;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .tabs button:hover {
    color: var(--ink);
  }

  .tabs button[aria-selected='true'] {
    background: var(--graphite);
    color: var(--white);
  }

  .view {
    position: relative;
    margin: 0;
  }

  .frame .view :global(.dark-img),
  .frame[data-theme='dark'] .view :global(.light-img) {
    display: none;
  }

  .frame[data-theme='dark'] .view :global(.dark-img) {
    display: block;
  }

  .theme {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink-2);
    cursor: pointer;
  }

  .theme:hover {
    border-color: var(--line-strong);
  }

  .theme[hidden] {
    display: none;
  }

  .theme :global(.i-sun),
  .theme[aria-pressed='true'] :global(.i-moon) {
    display: none;
  }

  .theme[aria-pressed='true'] :global(.i-sun) {
    display: block;
  }

  .view[hidden] {
    display: none;
  }

  .view:not([hidden]) {
    animation: view-in 0.4s var(--ease);
  }

  @keyframes view-in {
    from {
      opacity: 0.4;
    }
  }

  .badge {
    margin-left: auto;
    flex: none;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--teal-wash);
    color: var(--teal-deep);
    font-size: 0.75rem;
    font-weight: 550;
  }

  .frame :global(.img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .callout {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow);
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink);
    backdrop-filter: blur(6px);
  }

  .callout :global(svg) {
    color: var(--teal-dark);
  }


  :global(.js) .callout {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.6s var(--ease) 0.5s, transform 0.6s var(--ease) 0.5s;
  }

  :global(.js) .frame.is-visible .callout {
    opacity: 1;
    transform: none;
  }

  :global(.js) .frame.is-visible .callout:nth-of-type(2) {
    transition-delay: 0.8s;
  }

  :global(.js) .frame.is-visible .callout:nth-of-type(3) {
    transition-delay: 1.1s;
  }

  .steps {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-4);
    counter-reset: s;
  }

  .steps li {
    position: relative;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .steps li::before {
    counter-increment: s;
    content: '0' counter(s);
    position: absolute;
    top: var(--space-5);
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .steps li::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--teal-dark);
  }

  .ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-4);
    border-radius: 9px;
    background: var(--teal-wash);
    color: var(--teal-deep);
  }

  .steps-label {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .steps p {
    margin-top: 0.35rem;
    font-size: 0.9063rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .callout {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .badge,
    .dots {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-studio]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        if (on) toggle.hidden = !panel.querySelector('.dark-img');
      });
      if (focus) tabs[i].focus();
    };
    toggle.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      root.dataset.theme = dark ? 'dark' : 'light';
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.querySelector('.sr-only')!.textContent = dark ? 'Show the light theme' : 'Show the dark theme';
    });
    select(0);
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      if (k === 'ArrowRight' || k === 'ArrowLeft') {
        e.preventDefault();
        select((cur + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      }
    });
  });
</script>
