---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import overview from '../assets/product/studio-overview.png';
import answerLight from '../assets/product/analyst-answer-light.png';
import answerDark from '../assets/product/analyst-answer-dark.png';
import homeLight from '../assets/product/home-light.png';
import homeDark from '../assets/product/home-dark.png';
import whatifLight from '../assets/product/explorer-light.png';
import whatifDark from '../assets/product/explorer-dark.png';
import dataLight from '../assets/product/data-cards-light.png';
import dataDark from '../assets/product/data-cards-dark.png';
import verdictLight from '../assets/product/verdict-light.png';
import verdictDark from '../assets/product/verdict-dark.png';
import brainLight from '../assets/product/brain-overview-light.png';
import brainDark from '../assets/product/brain-overview-dark.png';
import graphLight from '../assets/product/brain-graph-light.png';
import graphDark from '../assets/product/brain-graph-dark.png';
import trustLight from '../assets/product/data-trust-light.png';
import trustDark from '../assets/product/data-trust-dark.png';
import healthLight from '../assets/product/health-light.png';
import healthDark from '../assets/product/health-dark.png';
import paletteLight from '../assets/product/palette-light.png';
import paletteDark from '../assets/product/palette-dark.png';
import convoLight from '../assets/product/conversation-light.png';
import convoDark from '../assets/product/conversation-dark.png';
import specsLight from '../assets/product/specialists-light.png';
import specsDark from '../assets/product/specialists-dark.png';

type Callout = { icon: string; text: string; x: string; y: string };
type View = { id: string; tab: string; img: ImageMetadata; dark?: ImageMetadata; alt: string; callouts: Callout[] };

const views: View[] = [
  {
    id: 'home', tab: 'Home', img: homeLight, dark: homeDark,
    alt: 'Lyst Home as one composer: Lyst’s mark above “What should Lyst work on?”, a box to ask anything (why something changed, a forecast, a what-if) or speak, three starter questions from approved metrics, a slim icon rail for Home, Data, Brain and Settings, and a dock with “2 need you”, “Get started 3/4” and Recent.',
    callouts: [
      { icon: 'Sparkles', text: 'Lyst’s mark shows what it is doing', x: '64%', y: '32%' },
      { icon: 'Mic', text: 'One place to type or speak', x: '52%', y: '67%' },
      { icon: 'PanelBottom', text: 'A dock for work in flight and recent answers', x: '52%', y: '88%' },
      { icon: 'PanelLeft', text: 'A slim icon rail', x: '13%', y: '15.5%' },
    ],
  },
  {
    id: 'answer', tab: 'Answer', img: answerLight, dark: answerDark,
    alt: 'Lyst answering “Why did operating margin change last quarter?”: a Verified badge, the finding (32.5% in Q3 2026, down 3.5 points on Q2), one line on why it matters (the decline is concentrated in EMEA), the trust line “All 10 checks passed”, a monthly trend, what to do, and two folded layers: “Why, and the details” and “Method, checks and queries”.',
    callouts: [
      { icon: 'Target', text: 'The finding first', x: '50%', y: '21%' },
      { icon: 'BadgeCheck', text: 'Every figure recomputed', x: '76%', y: '38%' },
      { icon: 'ChevronsUpDown', text: 'Details and method, one click away', x: '62%', y: '88%' },
    ],
  },
  {
    id: 'verdict', tab: 'Verdict', img: verdictLight, dark: verdictDark,
    alt: 'Under a Lyst answer: four menus (Keep watch, Download, Share, More) and “Is this right?” with Right, Partly and Wrong; Partly is selected, with Undo, and an optional “What should it have said?” correction box with Save and Skip.',
    callouts: [
      { icon: 'LayoutList', text: 'Four menus instead of a wall of buttons', x: '40%', y: '64%' },
      { icon: 'ThumbsUp', text: 'Right, Partly or Wrong, with undo', x: '76%', y: '64%' },
      { icon: 'PenLine', text: 'A correction Lyst recalls next time', x: '55%', y: '84%' },
    ],
  },
  {
    id: 'convo', tab: 'Chat', img: convoLight, dark: convoDark,
    alt: 'Lyst replying in conversation to “What can you help me with here?”: a plain answer about what it can do with this workspace’s approved metrics and datasets, labelled “A reply from what’s in this workspace. Nothing was computed, so there was nothing to verify.”, followed by offers under “Want me to” and a follow-up box.',
    callouts: [
      { icon: 'MessageSquareText', text: 'Plain replies, honestly labelled', x: '70%', y: '33%' },
      { icon: 'CornerDownRight', text: 'Say yes, or pick an offer', x: '62%', y: '47%' },
    ],
  },
  {
    id: 'whatif', tab: 'What if', img: whatifLight, dark: whatifDark,
    alt: 'The What if explorer in Lyst: sliders for revenue (+3%), COGS ratio, operating expenses (+6%) and labor share; operating margin 36.0% to 35.4% marked Worse and operating income $9.04M to $9.15M marked Better; what moves it most, worst, base and best cases, and a Monte Carlo range. All results labelled hypothetical.',
    callouts: [
      { icon: 'SlidersHorizontal', text: 'Move a driver, see the result', x: '62%', y: '10.4%' },
      { icon: 'ArrowUpDown', text: 'Better or worse, at a glance', x: '55%', y: '45.7%' },
      { icon: 'Dices', text: 'Worst, base, best and Monte Carlo', x: '58%', y: '85%' },
    ],
  },
  {
    id: 'data', tab: 'Data', img: dataLight, dark: dataDark,
    alt: 'Lyst Data: a header noting 2 of 5 datasets need attention, a library of datasets and approved metrics, and dataset cards such as Opportunities, Support demand, Monthly P&L and P&L from the ledger, each with its sensitivity, rows, data-through date and the measures it feeds, and Explore, Insights and More.',
    callouts: [
      { icon: 'LayoutGrid', text: 'What matters about each dataset', x: '54%', y: '35.5%' },
      { icon: 'Sparkles', text: 'Explore, Insights or More', x: '74%', y: '91%' },
    ],
  },
  {
    id: 'trust', tab: 'Trust', img: trustLight, dark: trustDark,
    alt: 'A dataset in Lyst, “P&L from the ledger”, with its sensitivity level, source of truth, and “Before you rely on it · 3”: a repeated row at its grain that would double count sums (Fix first), a negative cost value and a missing revenue value (Worth a look).',
    callouts: [
      { icon: 'TriangleAlert', text: 'Quality risks found on its own', x: '45%', y: '70%' },
    ],
  },
  {
    id: 'health', tab: 'Stale', img: healthLight, dark: healthDark,
    alt: 'A saved analysis in Lyst marked Out of date: “Pnl is now v2; this was built on v1”, with a proposal to re-run its question and a Rebuild it button.',
    callouts: [
      { icon: 'RefreshCcw', text: 'Knows when its data changed', x: '62%', y: '44%' },
      { icon: 'Wrench', text: 'One click to rebuild, re-verified', x: '32%', y: '54%' },
    ],
  },
  {
    id: 'brain', tab: 'Brain', img: brainLight, dark: brainDark,
    alt: 'Lyst Brain: one line on what it knows (6 approved metrics, 5 datasets, memories) and what needs you, four sections (Overview, Work, Knowledge, Specializations), and a search for “revenue” listing metrics, columns and a dataset, each with Open and Ask, then Used lately and Learned lately.',
    callouts: [
      { icon: 'Brain', text: 'What it knows, in one calm line', x: '74%', y: '25.6%' },
      { icon: 'Search', text: 'Search first, then open it or ask', x: '50%', y: '38%' },
    ],
  },
  {
    id: 'graph', tab: 'Map', img: graphLight, dark: graphDark,
    alt: 'Lyst Brain › Knowledge › Graph: an interactive map joining approved metrics, datasets, analyses, a memory and a business term, linked only where Lyst recorded a relation or a literal mention, with search, zoom and a List view.',
    callouts: [
      { icon: 'Share2', text: 'Everything Lyst knows, and how it links', x: '42%', y: '86%' },
      { icon: 'ShieldCheck', text: 'Only recorded relations, never guesses', x: '42%', y: '55%' },
    ],
  },
  {
    id: 'specs', tab: 'Experts', img: specsLight, dark: specsDark,
    alt: 'Lyst Brain › Specializations: 136 kinds of analyst work across 11 areas, 136 operational, with a search box, an area filter, and specializations such as Data Analyst, Business Intelligence Analyst and Business Analyst, each marked Operational.',
    callouts: [
      { icon: 'GraduationCap', text: '136 kinds of analyst work', x: '45%', y: '23.6%' },
      { icon: 'BadgeCheck', text: 'All 136 Operational', x: '73%', y: '23.6%' },
    ],
  },
  {
    id: 'palette', tab: '⌘K', img: paletteLight, dark: paletteDark,
    alt: 'The Lyst command palette (⌘K) searching “revenue forecast”: ask Lyst directly, matching metrics and saved analyses, and matching specialist expertise such as Forecasting Analyst and FP&A Analyst with their maturity levels.',
    callouts: [
      { icon: 'Command', text: 'Ask, jump or find from anywhere', x: '60%', y: '9%' },
      { icon: 'GraduationCap', text: 'Expertise, with honest maturity', x: '58%', y: '79%' },
    ],
  },
  {
    id: 'overview', tab: 'Dashboard', img: overview,
    alt: 'A dashboard generated by Lyst Studio: operating margin 32.4% and revenue $8.23M with sparklines, a monthly margin trend with a forecast band and anomaly markers, computed findings, and margin and revenue by region.',
    callouts: [
      { icon: 'TrendingUp', text: 'Forecast with an 80% interval', x: '50%', y: '45.5%' },
      { icon: 'Sparkles', text: 'Findings computed from the numbers', x: '71%', y: '26.4%' },
      { icon: 'MousePointerClick', text: 'Click a bar to filter the page', x: '30%', y: '62.2%' },
    ],
  },
];
import { studio } from '../data/content';
---

<section class="section studio" id="studio" aria-labelledby="studio-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">{studio.eyebrow}</p>
      <h2 id="studio-title" class="h2">{studio.headline}</h2>
      <p class="lede">{studio.lede}</p>
    </div>

    <div class="frame" data-reveal data-studio>
      <div class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="Product views">
          {
            views.map((v, i) => (
              <button
                type="button"
                role="tab"
                id={`st-tab-${v.id}`}
                aria-controls={`st-view-${v.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {v.tab}
              </button>
            ))
          }
        </div>
        <span class="badge">Real output · sample data</span>
        <button type="button" class="theme" data-theme-toggle aria-pressed="false">
          <Icon name="Moon" size={15} class="i-moon" />
          <Icon name="Sun" size={15} class="i-sun" />
          <span class="sr-only">Show the dark theme</span>
        </button>
      </div>
      {
        views.map((v, i) => (
          <figure class="view" id={`st-view-${v.id}`} role="tabpanel" aria-labelledby={`st-tab-${v.id}`} hidden={i !== 0}>
            {v.dark && (
              <Picture
                src={v.dark}
                formats={['avif', 'webp']}
                widths={[720, 1200, 1800, 2400]}
                sizes="(max-width: 1240px) 100vw, 1200px"
                alt={`${v.alt} Dark theme.`}
                loading="lazy"
                decoding="async"
                class="img dark-img"
                style={`aspect-ratio:${v.dark.width} / ${v.dark.height}`}
              />
            )}
            <Picture
              src={v.img}
              formats={['avif', 'webp']}
              widths={[720, 1200, 1800, 2400]}
              sizes="(max-width: 1240px) 100vw, 1200px"
              alt={v.alt}
              loading="lazy"
              decoding="async"
              class={v.dark ? 'img light-img' : 'img'}
              style={`aspect-ratio:${v.img.width} / ${v.img.height}`}
            />
            {v.callouts.map((c) => (
              <span class="callout" style={`left:${c.x};top:${c.y}`} aria-hidden="true">
                <Icon name={c.icon} size={14} /> {c.text}
              </span>
            ))}
          </figure>
        ))
      }
    </div>

    <h3 class="steps-label">{studio.stepsLabel}</h3>
    <ol class="steps">
      {
        studio.steps.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <span class="ic"><Icon name={s.icon} size={18} /></span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .frame {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    background: #fbfcfb;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .tabs {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--white);
  }

  .tabs button {
    flex: none;
    white-space: nowrap;
    min-height: 32px;
    padding: 0.2rem 0.8rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 550;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .tabs button:hover {
    color: var(--ink);
  }

  .tabs button[aria-selected='true'] {
    background: var(--graphite);
    color: var(--white);
  }

  .view {
    position: relative;
    margin: 0;
  }

  .frame .view :global(.dark-img),
  .frame[data-theme='dark'] .view :global(.light-img) {
    display: none;
  }

  .frame[data-theme='dark'] .view :global(.dark-img) {
    display: block;
  }

  .theme {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink-2);
    cursor: pointer;
  }

  .theme:hover {
    border-color: var(--line-strong);
  }

  .theme[hidden] {
    display: none;
  }

  .theme :global(.i-sun),
  .theme[aria-pressed='true'] :global(.i-moon) {
    display: none;
  }

  .theme[aria-pressed='true'] :global(.i-sun) {
    display: block;
  }

  .view[hidden] {
    display: none;
  }

  .view:not([hidden]) {
    animation: view-in 0.4s var(--ease);
  }

  @keyframes view-in {
    from {
      opacity: 0.4;
    }
  }

  .badge {
    margin-left: auto;
    flex: none;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--teal-wash);
    color: var(--teal-deep);
    font-size: 0.75rem;
    font-weight: 550;
  }

  .frame :global(.img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .callout {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow);
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink);
    backdrop-filter: blur(6px);
  }

  .callout :global(svg) {
    color: var(--teal-dark);
  }


  :global(.js) .callout {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.6s var(--ease) 0.5s, transform 0.6s var(--ease) 0.5s;
  }

  :global(.js) .frame.is-visible .callout {
    opacity: 1;
    transform: none;
  }

  :global(.js) .frame.is-visible .callout:nth-of-type(2) {
    transition-delay: 0.8s;
  }

  :global(.js) .frame.is-visible .callout:nth-of-type(3) {
    transition-delay: 1.1s;
  }

  .steps {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-4);
    counter-reset: s;
  }

  .steps li {
    position: relative;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .steps li::before {
    counter-increment: s;
    content: '0' counter(s);
    position: absolute;
    top: var(--space-5);
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .steps li::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--teal-dark);
  }

  .ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-4);
    border-radius: 9px;
    background: var(--teal-wash);
    color: var(--teal-deep);
  }

  .steps-label {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .steps p {
    margin-top: 0.35rem;
    font-size: 0.9063rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .callout {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .badge,
    .dots {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-studio]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        if (on) toggle.hidden = !panel.querySelector('.dark-img');
      });
      if (focus) tabs[i].focus();
    };
    toggle.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      root.dataset.theme = dark ? 'dark' : 'light';
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.querySelector('.sr-only')!.textContent = dark ? 'Show the light theme' : 'Show the dark theme';
    });
    select(0);
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      if (k === 'ArrowRight' || k === 'ArrowLeft') {
        e.preventDefault();
        select((cur + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      }
    });
  });
</script>
