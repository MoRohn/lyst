# All values are PUBLIC build-time settings. Never put secrets here:
# everything prefixed PUBLIC_ is compiled into the static site.

# Full origin the site is served from (no trailing slash).
# Project site:  https://morohn.github.io   Custom domain: https://lyst.example
PUBLIC_SITE_URL=http://localhost:4321
# Base path. Project site: /lyst   Custom domain or user site: /
PUBLIC_BASE_PATH=/
# stealth | public
PUBLIC_LAUNCH_MODE=stealth
# Base URL of the waitlist service (the optional FastAPI app in waitlist/), e.g.
# https://waitlist.example.com   The site posts to <base>/v1/registrations. Empty = truthful closed state.
PUBLIC_WAITLIST_ENDPOINT=

# Optional public contact address. Shown only when set.
PUBLIC_CONTACT_EMAIL=
# Optional public GitHub repository. Shown only when set.
PUBLIC_GITHUB_URL=
