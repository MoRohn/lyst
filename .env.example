# Non-secret settings only. Credentials (the OpenRouter key, database passwords, API tokens, the OIDC client
# secret) are entered in Settings > Secrets & Connections and sealed by Lyst; they are NOT read from this file.
# The master encryption key is a trust anchor: mounted under LYST_SECRETS_DIR (default /run/secrets), served by
# OpenBao, kept in the OS credential store (first-run setup / `lyst init`) or injected by the orchestrator.
# A secret-shaped name in this file is ignored with a warning.

# Models (optional). OpenRouter is the default provider; its key is connected in Settings.
LYST_LLM_TIER=balanced
# LYST_LLM_BASE_URL=http://ollama:11434/v1
# LYST_LLM_MODEL=qwen3:14b

# Sign-in (optional). Without OIDC, tokens are issued with `lyst token`.
# LYST_OIDC_ISSUER=https://id.example.com/realms/lyst
# LYST_OIDC_CLIENT_ID=lyst
# LYST_OIDC_REDIRECT_URL=https://lyst.example.com/api/auth/callback
# LYST_OIDC_ALLOWED_DOMAINS=example.com
# LYST_UI_URL=https://lyst.example.com

LYST_WORKERS=2
LYST_LOG_FORMAT=json
LYST_LOG_LEVEL=INFO
