# Non-secret settings only. Secrets (LYST_MASTER_KEY, LYST_OPENROUTER_API_KEY, LYST_LLM_API_KEY,
# LYST_OIDC_CLIENT_SECRET, connector passwords) are NOT read from this file: store them with
#   lyst secret set LYST_OPENROUTER_API_KEY        # OS credential store (macOS Keychain, Credential Manager, Secret Service)
# or mount them as files under LYST_SECRETS_DIR (default /run/secrets; Docker and Kubernetes secrets),
# or let the orchestrator inject them as environment variables. A secret-shaped name here is ignored with a warning.

# Models (optional). OpenRouter is the main provider when its key is in the credential store.
LYST_LLM_TIER=balanced
# LYST_LLM_BASE_URL=http://ollama:11434/v1
# LYST_LLM_MODEL=qwen3:14b

# Sign-in (optional). Without OIDC, tokens are issued with `lyst token`.
# LYST_OIDC_ISSUER=https://id.example.com/realms/lyst
# LYST_OIDC_CLIENT_ID=lyst
# LYST_OIDC_REDIRECT_URL=https://lyst.example.com/api/auth/callback
# LYST_OIDC_ALLOWED_DOMAINS=example.com
# LYST_UI_URL=https://lyst.example.com

LYST_WORKERS=2
LYST_LOG_FORMAT=json
LYST_LOG_LEVEL=INFO
